<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SJC Mpigi - Administrator Portal Login</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        navy: {
                            950: '#060a13',
                            900: '#090e1a',
                            850: '#0d1324',
                            800: '#111827',
                            700: '#1f2937'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        space: ['Space Grotesk', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body class="h-full flex items-center justify-center bg-navy-950 text-slate-100 font-sans antialiased relative overflow-hidden">
    <!-- Decorative background elements -->
    <div class="absolute top-0 left-0 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none -translate-x-1/2 -translate-y-1/2"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-amber-600/10 rounded-full blur-3xl pointer-events-none translate-x-1/2 translate-y-1/2"></div>
    
    <div class="w-full max-w-md p-6 relative z-10">
        <!-- Logo and Brand Header -->
        <div class="flex flex-col items-center mb-8 text-center">
            <div class="w-16 h-16 bg-blue-600 rounded-2xl flex items-center justify-center text-white shadow-xl shadow-blue-900/30 mb-4 border border-blue-400/30">
                <i class="bi bi-mortarboard-fill text-3xl"></i>
            </div>
            <h1 class="text-xl font-bold tracking-tight text-white font-space uppercase">ST. JOHN'S COLLEGE MPIGI</h1>
            <p class="text-xs text-amber-500 font-bold uppercase tracking-widest mt-1">Administrative CMS Portal</p>
        </div>

        <!-- Login Card -->
        <div class="bg-navy-900/90 border border-slate-800 rounded-2xl shadow-2xl p-6 space-y-6 backdrop-blur-md">
            <div>
                <h2 class="text-lg font-bold text-white font-space">Sign In</h2>
                <p class="text-xs text-slate-400 mt-1">Please enter your superuser credentials to manage the school directory.</p>
            </div>

            <!-- Error Alerts if password incorrect -->
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="p-3.5 bg-rose-950/40 border border-rose-900/50 rounded-xl flex items-center gap-2.5 text-xs font-semibold text-rose-400">
                    <i class="bi bi-exclamation-octagon-fill text-base"></i>
                    <span><%= error %></span>
                </div>
            <% } %>

            <!-- Main Form -->
            <form action="/login" method="POST" class="space-y-4">
                <div class="space-y-1.5">
                    <label for="email" class="text-[11px] font-bold text-slate-300 uppercase tracking-wider">Email Address</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-500 pointer-events-none">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input type="email" id="email" name="email" required placeholder="admin.sjc@mpigi.ac.ug" 
                            class="w-full bg-navy-850/80 border border-slate-800 focus:border-blue-500/50 focus:outline-none rounded-xl pl-9 pr-3 py-2.5 text-xs text-white placeholder-slate-600 transition-all">
                    </div>
                </div>

                <div class="space-y-1.5">
                    <div class="flex justify-between items-center">
                        <label for="password" class="text-[11px] font-bold text-slate-300 uppercase tracking-wider">Security Password</label>
                        <a href="#" class="text-[10px] text-blue-400 hover:underline">Forgot password?</a>
                    </div>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-500 pointer-events-none">
                            <i class="bi bi-lock"></i>
                        </span>
                        <input type="password" id="password" name="password" required placeholder="••••••••••••" 
                            class="w-full bg-navy-850/80 border border-slate-800 focus:border-blue-500/50 focus:outline-none rounded-xl pl-9 pr-3 py-2.5 text-xs text-white placeholder-slate-600 transition-all">
                    </div>
                </div>

                <div class="flex items-center justify-between pt-1">
                    <div class="flex items-center gap-2">
                        <input type="checkbox" id="remember" name="remember" checked class="w-4 h-4 bg-navy-850 border border-slate-800 rounded text-blue-600 focus:ring-0">
                        <label for="remember" class="text-[11px] text-slate-400 font-semibold cursor-pointer select-none">Keep me signed in</label>
                    </div>
                </div>

                <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 active:scale-[0.98] py-2.5 text-xs font-bold text-white rounded-xl shadow-lg shadow-blue-900/30 transition-all flex items-center justify-center gap-2">
                    <span>Access CMS Dashboard</span>
                    <i class="bi bi-arrow-right"></i>
                </button>
            </form>

            <div class="relative flex py-1 items-center">
                <div class="flex-grow border-t border-slate-800"></div>
                <span class="flex-shrink mx-3 text-[10px] text-slate-500 font-bold uppercase tracking-wider">or fast-track access</span>
                <div class="flex-grow border-t border-slate-800"></div>
            </div>

            <!-- Demo quick bypass button -->
            <form action="/login" method="POST">
                <input type="hidden" name="email" value="admin.sjc@mpigi.ac.ug">
                <input type="hidden" name="password" value="admin123">
                <button type="submit" class="w-full bg-navy-850 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 py-2.5 text-xs font-bold text-amber-400 hover:text-amber-300 rounded-xl transition-all flex items-center justify-center gap-2">
                    <i class="bi bi-lightning-charge-fill text-amber-500 animate-pulse"></i>
                    <span>⚡ Quick Demo One-Click Login</span>
                </button>
            </form>
        </div>

        <!-- Footer signature -->
        <p class="text-center text-[10px] text-slate-600 mt-8 font-medium">
            &copy; 2026 St. John's College Mpigi. Licensed Admin Operations Only.<br>
            <span class="text-slate-500 font-bold">Godliness and Hardwork Since 2004</span>
        </p>
    </div>
</body>
</html>
