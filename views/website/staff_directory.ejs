<%- include('../partials/header', { title: "St. John's College - Staff Directory", activePage: 'staff' }) %>

<div class="container py-5">

    <!-- Header Banner -->
    <div class="p-5 bg-sky-950 text-white rounded-4 shadow-sm mb-5 text-center">
        <i class="bi bi-people text-warning" style="font-size: 48px; color: #fbbf24 !important;"></i>
        <h1 class="display-6 mt-2 mb-2 font-serif text-white">Our Faculty & Staff Directory</h1>
        <p class="lead text-white-50 max-w-2xl mx-auto text-xs small" style="font-size: 14px;">
            Meet the dedicated administrators, passionate teachers, and hardworking support staff shaping the future at St. John's College Mpigi.
        </p>
    </div>

    <!-- Staff Categories -->
    <% if (typeof categorized_staff !== 'undefined' && Object.keys(categorized_staff).length > 0) { %>
        <% Object.entries(categorized_staff).forEach(function([category, members]) { %>
            <div class="mb-5">
                <div class="d-flex align-items-center gap-2 mb-4 border-bottom pb-2">
                    <i class="bi bi-award-fill text-sky-custom fs-4"></i>
                    <h3 class="text-sky-950 mb-0 font-serif"><%= category %></h3>
                    <span class="badge bg-sky-subtle text-sky-700 rounded-pill font-bold ms-2"><%= members.length %> Member<%= members.length !== 1 ? 's' : '' %></span>
                </div>
                
                <div class="row g-4">
                    <% members.forEach(function(staff) { %>
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 card-custom border-0 shadow-sm overflow-hidden bg-white d-flex flex-column">
                                <!-- Top Accent Color -->
                                <div class="bg-sky-custom" style="height: 6px;"></div>
                                
                                <div class="p-4 flex-grow-1">
                                    <div class="text-center mb-4">
                                        <!-- Photo Frame -->
                                        <% if (staff.photo) { %>
                                            <img src="<%= staff.photo %>" class="rounded-circle border border-sky-100 shadow-sm mb-3" style="width: 110px; height: 110px; object-fit: cover;" alt="<%= staff.name %>">
                                        <% } else { %>
                                            <div class="bg-sky-50 text-sky-custom rounded-circle border border-sky-100 d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 110px; height: 110px;">
                                                <i class="bi bi-person-fill" style="font-size: 3rem;"></i>
                                            </div>
                                        <% } %>
                                        
                                        <h5 class="text-slate-800 mb-1 font-bold"><%= staff.name %></h5>
                                        <span class="badge bg-warning-subtle text-warning-emphasis uppercase" style="font-size: 10px; letter-spacing: 0.5px; font-weight: 700; background-color: #fef3c7; color: #78350f;"><%= staff.role %></span>
                                    </div>
                                    
                                    <!-- Bio Section -->
                                    <p class="text-muted small mb-4 text-center italic" style="font-size: 11.5px; line-height: 1.6;">
                                        "<%= staff.bio %>"
                                    </p>
                                </div>
                                
                                <!-- Contact Details Footer inside Card -->
                                <div class="p-3 bg-light border-top mt-auto text-center">
                                    <div class="d-flex justify-content-center gap-3 small">
                                        <% if (staff.email) { %>
                                            <a href="mailto:<%= staff.email %>" class="text-decoration-none text-sky-700 hover-text-sky-900" title="<%= staff.email %>">
                                                <i class="bi bi-envelope-fill"></i> Email
                                            </a>
                                        <% } %>
                                        <% if (staff.phone) { %>
                                            <a href="tel:<%= staff.phone %>" class="text-decoration-none text-success hover-text-success-emphasis" title="<%= staff.phone %>">
                                                <i class="bi bi-telephone-fill"></i> Contact
                                            </a>
                                        <% } %>
                                        <a href="/admin?tab=staff" class="text-decoration-none text-muted hover-text-dark" title="Manage details in admin portal">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% }) %>
    <% } else { %>
        <div class="text-center p-5 bg-white border rounded-4 text-muted shadow-sm">
            <i class="bi bi-people-fill fs-1 text-slate-300"></i>
            <h4 class="mt-3 text-sky-950 font-bold">No Staff Members Registered Yet</h4>
            <p class="mt-2 text-muted small max-w-sm mx-auto">
                Administrators can populate the school directory by logging into the Admin Control Panel.
            </p>
            <a href="/admin?tab=staff" class="btn btn-sky-custom mt-3 px-4 py-2 rounded-3">
                <i class="bi bi-plus-circle"></i> Add First Staff Member
            </a>
        </div>
    <% } %>

</div>

<%- include('../partials/footer') %>
