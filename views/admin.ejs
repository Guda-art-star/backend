                                <div class="flex gap-4">
                                    <div class="w-12 h-12 bg-indigo-500/10 border border-indigo-500/20 rounded-lg flex items-center justify-center text-indigo-400 text-lg flex-shrink-0"><i class="bi bi-person-badge"></i></div>
