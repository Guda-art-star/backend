                                        <p class="text-[10px] text-slate-400 line-clamp-2"><%= item.excerpt %></p>
                                        <p class="text-[9px] text-slate-500 font-semibold uppercase"><i class="bi bi-calendar"></i> <%= item.date %></p>
                                    </div>
                                </div>
                                <form method="POST" action="/admin/announcements/delete/<%= item.id %>" onsubmit="return confirm('Permanently delete circular notice?');" class="flex-shrink-0">
                                    <button type="submit" class="p-1 px-1.5 bg-rose-600/15 hover:bg-rose-600 text-rose-400 hover:text-white rounded text-[11px]"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="text-center p-12 bg-navy-900 border border-slate-800 rounded-xl text-slate-500">
                        <i class="bi bi-megaphone-fill text-3xl"></i>
                        <p class="mt-2.5 text-xs font-semibold uppercase tracking-wider">No announcements posted yet</p>
                    </div>
                <% } %>
            <% } %>

            <!-- TAB CONTAINER: SCHOOL CALENDAR EVENTS -->
