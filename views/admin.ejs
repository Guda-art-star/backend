                                                    <span class="px-2 py-0.5 bg-emerald-500/10 text-emerald-400 rounded text-[10px] font-bold uppercase">Approved</span>
                                                <% } else { %>
                                                    <span class="px-2 py-0.5 bg-amber-500/10 text-amber-400 rounded text-[10px] font-bold uppercase">Pending Approval</span>
                                                <% } %>
                                            </td>
                                            <td class="p-4">
                                                <div class="flex items-center justify-end gap-2">
                                                    <form method="POST" action="/admin/alumni/toggle/<%= alumn.id %>">
                                                        <button type="submit" class="p-1 px-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white rounded text-[10px] font-bold transition-all">
                                                            <%= alumn.is_approved ? 'Unapprove' : 'Approve' %>
                                                        </button>
                                                    </form>
                                                    <form method="POST" action="/admin/alumni/delete/<%= alumn.id %>" onsubmit="return confirm('Permanently remove alumni profile?');">
                                                        <button type="submit" class="p-1 px-1.5 bg-rose-600/15 hover:bg-rose-600 text-rose-400 hover:text-white rounded text-[11px]"><i class="bi bi-trash"></i></button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                <% } else { %>
                    <div class="text-center p-12 bg-navy-900 border border-slate-800 rounded-xl text-slate-500">
                        <i class="bi bi-people-fill text-3xl"></i>
                        <p class="mt-2.5 text-xs font-semibold uppercase tracking-wider">No alumni registrants found</p>
                    </div>
                <% } %>
            <% } %>

            <!-- TAB CONTAINER: BULLETIN BOARD NEWS -->
