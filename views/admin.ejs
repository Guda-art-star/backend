                </div>

                <% if (alumni && alumni.length > 0) { %>
                    <div class="bg-navy-900 border border-slate-800 rounded-xl overflow-hidden">
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse text-xs">
                                <thead>
                                    <tr class="border-b border-slate-800 bg-navy-850/50 text-slate-400 font-bold uppercase tracking-wider">
                                        <th class="p-4">Alumnus Name</th>
                                        <th class="p-4">Class Year</th>
                                        <th class="p-4">Profession / Job</th>
                                        <th class="p-4">Memory quote</th>
                                        <th class="p-4">Approval State</th>
                                        <th class="p-4 text-right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-800/85">
                                    <% alumni.forEach(function(alumn) { %>
                                        <tr class="hover:bg-slate-800/20 transition-all">
                                            <td class="p-4 flex items-center gap-3">
                                                <% if (alumn.photo) { %>
                                                    <img src="<%= alumn.photo %>" class="w-8 h-8 rounded-full object-cover border border-slate-700">
                                                <% } else { %>
                                                    <div class="w-8 h-8 rounded-full bg-slate-800 text-slate-400 flex items-center justify-center text-xs font-bold font-mono"><%= alumn.name[0] %></div>
                                                <% } %>
