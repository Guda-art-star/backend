                        <div class="md:col-span-2 space-y-1.5">
                            <label class="font-semibold text-slate-400">Professional Bio</label>
                            <textarea name="bio" rows="2" placeholder="Describe staff history and qualifications..." class="w-full bg-navy-850 border border-slate-800 rounded-lg p-3 text-white focus:outline-none focus:border-blue-500/50"></textarea>
                        </div>
                        <div class="md:col-span-2 flex justify-end gap-2 pt-2">
