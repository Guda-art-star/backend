                                <div class="flex gap-4">
                                    <div class="text-center bg-blue-600/10 border border-blue-500/25 p-2 rounded-lg flex flex-col justify-center items-center w-12 h-12 flex-shrink-0 text-blue-400">
                                        <span class="font-black text-xs leading-none font-space"><%= new Date(event.date).getDate() %></span>
                                        <span class="text-[8px] uppercase tracking-wider font-bold mt-1"><%= new Date(event.date).toLocaleDateString('en-US', { month: 'short' }) %></span>
                                    </div>
                                    <div class="space-y-1">
                                        <span class="inline-block px-1.5 py-0.5 bg-slate-800 text-[8px] font-bold text-slate-400 rounded uppercase tracking-wider"><%= event.category %></span>
                                        <h4 class="text-xs font-bold text-white"><%= event.title %></h4>
                                        <div class="flex flex-wrap gap-x-3 gap-y-1 text-[9px] text-slate-500 font-semibold font-mono">
                                            <span><i class="bi bi-clock"></i> <%= event.time %></span>
                                            <span><i class="bi bi-geo-alt"></i> <%= event.location %></span>
                                            <span><i class="bi bi-cash"></i> <%= event.cost %></span>
                                        </div>
                                    </div>
                                </div>
                                <form method="POST" action="/admin/events/delete/<%= event.id %>" onsubmit="return confirm('Permanently remove calendar event?');" class="flex-shrink-0">
                                    <button type="submit" class="p-1 px-1.5 bg-rose-600/15 hover:bg-rose-600 text-rose-400 hover:text-white rounded text-[11px]"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="text-center p-12 bg-navy-900 border border-slate-800 rounded-xl text-slate-500">
                        <i class="bi bi-calendar-event text-3xl"></i>
                        <p class="mt-2.5 text-xs font-semibold uppercase tracking-wider">No events listed in school calendar</p>
                    </div>
                <% } %>
            <% } %>

