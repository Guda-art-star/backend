                        </div>
                        <div class="space-y-1.5">
                            <label class="font-semibold text-slate-400">Event Date</label>
                            <input type="date" name="date" required value="2026-07-25" class="w-full bg-navy-850 border border-slate-800 rounded-lg p-2.5 text-white focus:outline-none focus:border-blue-500/50">
