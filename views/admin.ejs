<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SJC Mpigi - CMS Administration Suite</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        navy: {
                            950: '#060a13',
                            900: '#090e1a',
                            850: '#0d1324',
                            800: '#111827',
                            700: '#1f2937',
                            600: '#374151'
                        },
                        gold: {
                            500: '#f59e0b',
                            600: '#d97706'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Playfair Display', 'Georgia', 'serif'],
                        space: ['Space Grotesk', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <style>
        /* Custom scrollbar for premium feel */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #090e1a;
        }
        ::-webkit-scrollbar-thumb {
            background: #1f2937;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #374151;
        }
        
        .active-glow {
            box-shadow: 0 0 15px rgba(59, 130, 246, 0.15);
        }
    </style>
</head>
<body class="h-full bg-navy-950 text-slate-100 font-sans antialiased overflow-hidden flex">

    <!-- 1. LEFT SIDEBAR PANEL (ST. JOHN'S COLLEGE MPIGI CMS Dashboard) -->
    <aside class="w-64 bg-navy-900 border-r border-slate-800 flex flex-col flex-shrink-0 h-full">
        <!-- Sidebar Brand Header -->
        <div class="p-5 border-b border-slate-800 flex items-center gap-3">
            <div class="w-10 h-10 bg-blue-600 rounded-lg flex items-center justify-center text-white active-glow">
                <i class="bi bi-mortarboard-fill text-xl"></i>
            </div>
            <div>
                <h1 class="text-xs font-black tracking-wider uppercase text-blue-400 font-space">ST. JOHN'S COLLEGE</h1>
                <p class="text-[10px] text-slate-400 font-semibold uppercase tracking-widest">MPIGI CMS Suite</p>
            </div>
        </div>

        <!-- Sidebar Scrolled Menus -->
        <div class="flex-grow overflow-y-auto p-4 space-y-6">
            <!-- Section: CONTENT -->
            <div>
                <h2 class="text-[10px] font-bold text-slate-500 uppercase tracking-widest px-3 mb-2">CONTENT</h2>
                <div class="space-y-1">
                    <a href="/admin?tab=dashboard" class="flex items-center gap-3 px-3 py-2 rounded-lg text-xs font-semibold tracking-wide transition-all <%= currentTab === 'dashboard' ? 'bg-blue-600/10 text-blue-400 border-l-2 border-blue-500' : 'text-slate-400 hover:bg-slate-800/50 hover:text-slate-200' %>">
                        <i class="bi bi-grid-1x2"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="/admin?tab=settings" class="flex items-center gap-3 px-3 py-2 rounded-lg text-xs font-semibold tracking-wide transition-all <%= currentTab === 'settings' ? 'bg-blue-600/10 text-blue-400 border-l-2 border-blue-500' : 'text-slate-400 hover:bg-slate-800/50 hover:text-slate-200' %>">
                        <i class="bi bi-gear"></i>
                        <span>Site Settings</span>
                    </a>
                    
                    <!-- Homepage Sections Dropdown-styled Accordion -->
                    <div class="space-y-1">
                        <div class="flex items-center justify-between px-3 py-2 rounded-lg text-xs font-semibold tracking-wide text-slate-400 cursor-pointer hover:bg-slate-800/50">
                            <div class="flex items-center gap-3">
                                <i class="bi bi-house-door"></i>
                                <span>Homepage Sections</span>
                            </div>
                            <i class="bi bi-chevron-down text-[10px]"></i>
                        </div>
                        <div class="pl-7 space-y-1 border-l border-slate-800 ml-5">
                            <a href="/admin?tab=hero_section" class="block py-1 px-2 text-xs font-medium rounded transition-all <%= currentTab === 'hero_section' ? 'text-blue-400 font-bold' : 'text-slate-400 hover:text-slate-200' %>">
                                <span class="mr-1.5">•</span> Hero Section
                            </a>
                            <a href="/admin?tab=about_section" class="block py-1 px-2 text-xs font-medium rounded transition-all <%= currentTab === 'about_section' ? 'text-blue-400 font-bold' : 'text-slate-400 hover:text-slate-200' %>">
                                <span class="mr-1.5">•</span> About Section
                            </a>
                            <a href="/admin?tab=events" class="block py-1 px-2 text-xs font-medium rounded transition-all <%= currentTab === 'events' ? 'text-blue-400 font-bold' : 'text-slate-400 hover:text-slate-200' %>">
                                <span class="mr-1.5">•</span> Features / Highlights
                            </a>
                            <a href="/admin?tab=gallery_section" class="block py-1 px-2 text-xs font-medium rounded transition-all <%= currentTab === 'gallery_section' ? 'text-blue-400 font-bold' : 'text-slate-400 hover:text-slate-200' %>">
                                <span class="mr-1.5">•</span> Gallery Section
                            </a>
                            <a href="/admin?tab=announcements" class="block py-1 px-2 text-xs font-medium rounded transition-all <%= currentTab === 'announcements' ? 'text-blue-400 font-bold' : 'text-slate-400 hover:text-slate-200' %>">
                                <span class="mr-1.5">•</span> News Section
                            </a>
                            <a href="/admin?tab=cta_section" class="block py-1 px-2 text-xs font-medium rounded transition-all <%= currentTab === 'cta_section' ? 'text-blue-400 font-bold' : 'text-slate-400 hover:text-slate-200' %>">
                                <span class="mr-1.5">•</span> Call To Action
                            </a>
                            <a href="/admin?tab=footer_section" class="block py-1 px-2 text-xs font-medium rounded transition-all <%= currentTab === 'footer_section' ? 'text-blue-400 font-bold' : 'text-slate-400 hover:text-slate-200' %>">
                                <span class="mr-1.5">•</span> Footer
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section: OTHER PAGES -->
            <div>
                <h2 class="text-[10px] font-bold text-slate-500 uppercase tracking-widest px-3 mb-2">OTHER PAGES</h2>
                <div class="space-y-1">
                    <a href="/admin?tab=about_us" class="flex items-center gap-3 px-3 py-2 rounded-lg text-xs font-semibold tracking-wide transition-all <%= currentTab === 'about_us' ? 'bg-blue-600/10 text-blue-400 border-l-2 border-blue-500' : 'text-slate-400 hover:bg-slate-800/50 hover:text-slate-200' %>">
                        <i class="bi bi-file-earmark-text"></i>
                        <span>About Us</span>
                    </a>
                    <a href="/admin?tab=staff" class="flex items-center gap-3 px-3 py-2 rounded-lg text-xs font-semibold tracking-wide transition-all <%= currentTab === 'staff' ? 'bg-blue-600/10 text-blue-400 border-l-2 border-blue-500' : 'text-slate-400 hover:bg-slate-800/50 hover:text-slate-200' %>">
                        <i class="bi bi-mortarboard"></i>
                        <span>Academics & Faculty</span>
                    </a>
                    <a href="/admin?tab=admissions" class="flex items-center gap-3 px-3 py-2 rounded-lg text-xs font-semibold tracking-wide transition-all <%= currentTab === 'admissions' ? 'bg-blue-600/10 text-blue-400 border-l-2 border-blue-500' : 'text-slate-400 hover:bg-slate-800/50 hover:text-slate-200' %>">
                        <i class="bi bi-file-earmark-person"></i>
                        <span>Admission Vetting</span>
                    </a>
                    <a href="/admin?tab=alumni" class="flex items-center gap-3 px-3 py-2 rounded-lg text-xs font-semibold tracking-wide transition-all <%= currentTab === 'alumni' ? 'bg-blue-600/10 text-blue-400 border-l-2 border-blue-500' : 'text-slate-400 hover:bg-slate-800/50 hover:text-slate-200' %>">
                        <i class="bi bi-people"></i>
                        <span>Alumni</span>
                    </a>
                    <a href="/admin?tab=faqs" class="flex items-center gap-3 px-3 py-2 rounded-lg text-xs font-semibold tracking-wide transition-all <%= currentTab === 'faqs' ? 'bg-blue-600/10 text-blue-400 border-l-2 border-blue-500' : 'text-slate-400 hover:bg-slate-800/50 hover:text-slate-200' %>">
                        <i class="bi bi-chat-square-text"></i>
                        <span>Contact Us / FAQs</span>
                    </a>
                </div>
            </div>

            <!-- Section: MEDIA & CAMPAIGNS -->
            <div>
                <h2 class="text-[10px] font-bold text-slate-500 uppercase tracking-widest px-3 mb-2">MEDIA & UTILITIES</h2>
                <div class="space-y-1">
                    <a href="/admin?tab=sms" class="flex items-center gap-3 px-3 py-2 rounded-lg text-xs font-semibold tracking-wide transition-all <%= currentTab === 'sms' ? 'bg-blue-600/10 text-blue-400 border-l-2 border-blue-500' : 'text-slate-400 hover:bg-slate-800/50 hover:text-slate-200' %>">
                        <i class="bi bi-chat-dots"></i>
                        <span>Bulk SMS Campaigns</span>
                    </a>
                    <a href="/admin?tab=gallery_manager" class="flex items-center gap-3 px-3 py-2 rounded-lg text-xs font-semibold tracking-wide transition-all <%= currentTab === 'gallery_manager' ? 'bg-blue-600/10 text-blue-400 border-l-2 border-blue-500' : 'text-slate-400 hover:bg-slate-800/50 hover:text-slate-200' %>">
                        <i class="bi bi-images"></i>
                        <span>Gallery Photos</span>
                    </a>
                    <a href="/admin?tab=documents_manager" class="flex items-center gap-3 px-3 py-2 rounded-lg text-xs font-semibold tracking-wide transition-all <%= currentTab === 'documents_manager' ? 'bg-blue-600/10 text-blue-400 border-l-2 border-blue-500' : 'text-slate-400 hover:bg-slate-800/50 hover:text-slate-200' %>">
                        <i class="bi bi-file-earmark-arrow-up"></i>
                        <span>Documents Uploads</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Sidebar Logged-in admin indicator -->
        <div class="p-4 border-t border-slate-800 bg-navy-950/50 flex items-center justify-between gap-3">
            <div class="flex items-center gap-3 overflow-hidden">
                <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?q=80&w=150" class="w-8 h-8 rounded-full object-cover border border-slate-700" alt="Admin Avatar">
                <div class="overflow-hidden">
                    <p class="text-xs font-bold text-slate-200 truncate">Super Admin</p>
                    <p class="text-[10px] text-slate-500 font-semibold truncate">admin.sjc@mpigi.ac.ug</p>
                </div>
            </div>
            <a href="/logout" title="Sign Out" class="text-slate-500 hover:text-rose-400 p-1.5 rounded-lg hover:bg-slate-800/80 transition-all flex items-center justify-center">
                <i class="bi bi-box-arrow-right text-base"></i>
            </a>
        </div>
    </aside>

    <!-- 2. MAIN APP CONTENT CONTAINER (Right side of Sidebar) -->
    <main class="flex-grow flex flex-col h-full overflow-hidden">
        
        <!-- TOP NAVIGATION BAR -->
        <header class="h-14 bg-navy-900 border-b border-slate-800 px-6 flex items-center justify-between flex-shrink-0">
            <!-- Breadcrumbs Left -->
            <div class="flex items-center gap-2 text-xs text-slate-400 font-medium">
                <i class="bi bi-house-fill text-slate-500"></i>
                <i class="bi bi-chevron-right text-[10px] text-slate-600"></i>
                <% if (currentTab === 'hero_section') { %>
                    <span>Homepage Sections</span>
                    <i class="bi bi-chevron-right text-[10px] text-slate-600"></i>
                    <span class="text-slate-200 font-bold">Hero Section</span>
                <% } else if (currentTab === 'dashboard') { %>
                    <span class="text-slate-200 font-bold">Dashboard Analytics</span>
                <% } else if (currentTab === 'admissions') { %>
                    <span>Other Pages</span>
                    <i class="bi bi-chevron-right text-[10px] text-slate-600"></i>
                    <span class="text-slate-200 font-bold">Admissions Dossiers</span>
                <% } else if (currentTab === 'alumni') { %>
                    <span>Other Pages</span>
                    <i class="bi bi-chevron-right text-[10px] text-slate-600"></i>
                    <span class="text-slate-200 font-bold">Alumni Board</span>
                <% } else if (currentTab === 'announcements') { %>
                    <span>Homepage Sections</span>
                    <i class="bi bi-chevron-right text-[10px] text-slate-600"></i>
                    <span class="text-slate-200 font-bold">News Bulletins</span>
                <% } else if (currentTab === 'events') { %>
                    <span>Homepage Sections</span>
                    <i class="bi bi-chevron-right text-[10px] text-slate-600"></i>
                    <span class="text-slate-200 font-bold">Highlights & Calendar</span>
                <% } else if (currentTab === 'staff') { %>
                    <span>Other Pages</span>
                    <i class="bi bi-chevron-right text-[10px] text-slate-600"></i>
                    <span class="text-slate-200 font-bold">Staff Directory</span>
                <% } else if (currentTab === 'faqs') { %>
                    <span>Other Pages</span>
                    <i class="bi bi-chevron-right text-[10px] text-slate-600"></i>
                    <span class="text-slate-200 font-bold">Portal FAQs</span>
                <% } else if (currentTab === 'sms') { %>
                    <span>Campaigns</span>
                    <i class="bi bi-chevron-right text-[10px] text-slate-600"></i>
                    <span class="text-slate-200 font-bold">Bulk SMS Portal</span>
                <% } else { %>
                    <span class="text-slate-200 font-bold capitalize"><%= currentTab.replace('_', ' ') %></span>
                <% } %>
            </div>

            <!-- Top bar Icons & Avatar Right -->
            <div class="flex items-center gap-4">
                <!-- Notifications Bell with Red count '3' badge -->
                <div class="relative cursor-pointer hover:bg-slate-800 p-1.5 rounded-full transition-all">
                    <i class="bi bi-bell text-slate-400 text-lg"></i>
                    <span class="absolute top-1.5 right-1.5 w-4 h-4 bg-rose-500 rounded-full text-[9px] font-bold text-white flex items-center justify-center">3</span>
                </div>
                
                <div class="h-6 w-px bg-slate-800"></div>

                <!-- Admin Profile Dropdown -->
                <div class="flex items-center gap-2.5">
                    <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?q=80&w=150" class="w-7 h-7 rounded-full object-cover border border-slate-700" alt="Admin Profile">
                    <div class="hidden md:block text-left">
                        <p class="text-xs font-bold text-slate-300">Admin</p>
                        <p class="text-[9px] text-slate-500 font-medium font-mono">Super Administrator</p>
                    </div>
                </div>
            </div>
        </header>

        <!-- Dynamic Message Flash Banner (In-Memory alerts) -->
        <% if (messages && messages.length > 0) { %>
            <div class="px-6 pt-4 flex-shrink-0">
                <% messages.forEach(function(msg) { %>
                    <div class="p-3.5 rounded-xl border flex items-center gap-3 text-xs font-medium tracking-wide <%= msg.type === 'success' ? 'bg-emerald-950/40 text-emerald-400 border-emerald-900/50' : 'bg-rose-950/40 text-rose-400 border-rose-900/50' %>">
                        <i class="bi <%= msg.type === 'success' ? 'bi-patch-check-fill' : 'bi-exclamation-octagon-fill' %> text-lg"></i>
                        <span><%= msg.text %></span>
                    </div>
                <% }) %>
            </div>
        <% } %>

        <!-- SCROLLABLE TAB PANEL WINDOW -->
        <div class="flex-grow overflow-y-auto p-6 space-y-6">

            <!-- TAB CONTAINER: HERO SECTION (Pixel Perfect Copy) -->
            <% if (currentTab === 'hero_section') { %>
                <!-- Page Title Header Row -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-5">
                    <div>
                        <h2 class="text-xl font-bold tracking-tight text-white font-space">Hero Section</h2>
                        <p class="text-xs text-slate-400">Manage the hero section content that appears on your homepage.</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <a href="/website" target="_blank" class="flex items-center gap-2 px-3 py-1.5 text-xs font-bold text-slate-300 border border-slate-700 hover:bg-slate-800 rounded-lg transition-all">
                            <i class="bi bi-box-arrow-up-right"></i>
                            <span>Visit Website</span>
                        </a>
                        <button type="submit" form="heroSectionForm" class="flex items-center gap-2 px-4 py-1.5 text-xs font-bold bg-blue-600 hover:bg-blue-500 text-white rounded-lg shadow shadow-blue-900/30 transition-all">
                            <i class="bi bi-save2-fill"></i>
                            <span>Save All Changes</span>
                        </button>
                    </div>
                </div>

                <!-- Custom Header Tabs Under title -->
                <div class="flex gap-4 border-b border-slate-800 text-xs font-bold">
                    <span class="py-2.5 border-b-2 border-blue-500 text-blue-400 cursor-pointer">Content</span>
                    <span class="py-2.5 text-slate-500 hover:text-slate-300 cursor-pointer transition-all">Settings</span>
                    <span class="py-2.5 text-slate-500 hover:text-slate-300 cursor-pointer transition-all">Background</span>
                    <span class="py-2.5 text-slate-500 hover:text-slate-300 cursor-pointer transition-all">SEO</span>
                </div>

                <!-- Splitted Edit Grid: Form on Left, Live Preview on Right -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                    <!-- Left Edit Form Column -->
                    <div class="lg:col-span-7 space-y-5">
                        <form id="heroSectionForm" method="POST" action="/admin/hero-section/save" class="space-y-5">
                            
                            <!-- Form Box 1: Badge Info -->
                            <div class="p-5 bg-navy-900 border border-slate-800 rounded-xl space-y-3">
                                <div class="flex items-center justify-between">
                                    <label class="text-xs font-bold text-slate-300 tracking-wide">Badge</label>
                                    <span id="badgeCharCount" class="text-[10px] text-slate-500 font-bold font-mono">20/30</span>
                                </div>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-500">
                                        <i class="bi bi-hexagon-fill text-xs text-amber-500"></i>
                                    </div>
                                    <input type="text" id="badgeInput" name="badge" maxlength="30" value="<%= heroConfig.badge %>" placeholder="e.g. ACADEMIC DISTINCTION" class="w-full bg-navy-850 border border-slate-800 focus:border-blue-500/50 rounded-lg pl-9 pr-3 py-2 text-xs text-white placeholder-slate-600 focus:outline-none transition-all">
                                </div>
                            </div>

                            <!-- Form Box 2: Title Rich text editor emulation -->
                            <div class="p-5 bg-navy-900 border border-slate-800 rounded-xl space-y-3">
                                <div class="flex items-center justify-between">
                                    <label class="text-xs font-bold text-slate-300 tracking-wide">Title</label>
                                    <span id="titleCharCount" class="text-[10px] text-slate-500 font-bold font-mono">34/100</span>
                                </div>
                                <!-- Rich Text Simulation Toolbar -->
                                <div class="flex items-center gap-1 bg-navy-850 p-1.5 border border-slate-800 rounded-t-lg">
                                    <button type="button" class="p-1 px-2 text-xs font-bold hover:bg-slate-800 text-slate-300 hover:text-white rounded">H</button>
                                    <button type="button" class="p-1 px-2 text-xs font-extrabold hover:bg-slate-800 text-slate-300 hover:text-white rounded">B</button>
                                    <button type="button" class="p-1 px-2 text-xs italic hover:bg-slate-800 text-slate-300 hover:text-white rounded">I</button>
                                    <button type="button" class="p-1 px-2 text-xs underline hover:bg-slate-800 text-slate-300 hover:text-white rounded">U</button>
                                    <button type="button" class="p-1 px-2 text-xs line-through hover:bg-slate-800 text-slate-300 hover:text-white rounded">S</button>
                                    <div class="h-4 w-px bg-slate-800 mx-1"></div>
                                    <button type="button" class="p-1 text-slate-400 hover:text-white rounded"><i class="bi bi-list-ul text-xs"></i></button>
                                    <button type="button" class="p-1 text-slate-400 hover:text-white rounded"><i class="bi bi-link-45deg text-xs"></i></button>
                                    <button type="button" class="p-1 text-slate-400 hover:text-white rounded"><i class="bi bi-text-align-left text-xs"></i></button>
                                </div>
                                <textarea id="titleInput" name="title" rows="3" maxlength="100" class="w-full bg-navy-850 border-x border-b border-slate-800 focus:border-blue-500/50 rounded-b-lg p-3 text-xs text-white focus:outline-none placeholder-slate-600 font-medium tracking-wide transition-all"><%= heroConfig.title %></textarea>
                            </div>

                            <!-- Form Box 3: Description Rich text editor emulation -->
                            <div class="p-5 bg-navy-900 border border-slate-800 rounded-xl space-y-3">
                                <div class="flex items-center justify-between">
                                    <label class="text-xs font-bold text-slate-300 tracking-wide">Description</label>
                                    <span id="descCharCount" class="text-[10px] text-slate-500 font-bold font-mono">86/160</span>
                                </div>
                                <!-- Rich Text Emulation Toolbar -->
                                <div class="flex items-center gap-1 bg-navy-850 p-1.5 border border-slate-800 rounded-t-lg">
                                    <button type="button" class="p-1 px-2 text-xs font-bold hover:bg-slate-800 text-slate-300 hover:text-white rounded">H</button>
                                    <button type="button" class="p-1 px-2 text-xs font-extrabold hover:bg-slate-800 text-slate-300 hover:text-white rounded">B</button>
                                    <button type="button" class="p-1 px-2 text-xs italic hover:bg-slate-800 text-slate-300 hover:text-white rounded">I</button>
                                    <button type="button" class="p-1 px-2 text-xs underline hover:bg-slate-800 text-slate-300 hover:text-white rounded">U</button>
                                    <button type="button" class="p-1 px-2 text-xs line-through hover:bg-slate-800 text-slate-300 hover:text-white rounded">S</button>
                                    <div class="h-4 w-px bg-slate-800 mx-1"></div>
                                    <button type="button" class="p-1 text-slate-400 hover:text-white rounded"><i class="bi bi-list-ul text-xs"></i></button>
                                    <button type="button" class="p-1 text-slate-400 hover:text-white rounded"><i class="bi bi-link-45deg text-xs"></i></button>
                                    <button type="button" class="p-1 text-slate-400 hover:text-white rounded"><i class="bi bi-text-align-left text-xs"></i></button>
                                </div>
                                <textarea id="descInput" name="description" rows="3" maxlength="160" class="w-full bg-navy-850 border-x border-b border-slate-800 focus:border-blue-500/50 rounded-b-lg p-3 text-xs text-slate-300 focus:outline-none placeholder-slate-600 transition-all"><%= heroConfig.description %></textarea>
                            </div>

                            <!-- Form Box 4: Buttons side-by-side editing -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                <!-- Primary Button Panel -->
                                <div class="p-5 bg-navy-900 border border-slate-800 rounded-xl space-y-4">
