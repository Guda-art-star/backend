                        </div>
                        <div class="space-y-1.5">
                            <label class="font-semibold text-slate-400">Category Tag</label>
                            <select name="category" class="w-full bg-navy-850 border border-slate-800 rounded-lg p-2.5 text-slate-300 focus:outline-none focus:border-blue-500/50">
                                <option value="General Circular">General Circular</option>
                                <option value="Admissions">Admissions</option>
                                <option value="Sports">Sports</option>
                                <option value="Academic Notice">Academic Notice</option>
                            </select>
                        </div>
                        <div class="space-y-1.5">
                            <label class="font-semibold text-slate-400">Publication Date</label>
                            <input type="date" name="date" required value="2026-07-14" class="w-full bg-navy-850 border border-slate-800 rounded-lg p-2.5 text-white focus:outline-none focus:border-blue-500/50">
                        </div>
                        <div class="space-y-1.5">
                            <label class="font-semibold text-slate-400">Excerpt / short preview</label>
                            <input type="text" name="excerpt" required placeholder="Quick preview snippet text" class="w-full bg-navy-850 border border-slate-800 rounded-lg p-2.5 text-white focus:outline-none focus:border-blue-500/50">
                        </div>
                        <div class="md:col-span-2 space-y-1.5">
                            <label class="font-semibold text-slate-400">Full Circular content</label>
                            <textarea name="content" rows="4" required placeholder="Type formal text of circular here..." class="w-full bg-navy-850 border border-slate-800 rounded-lg p-3 text-white focus:outline-none focus:border-blue-500/50"></textarea>
                        </div>
                        <div class="md:col-span-2 flex justify-end gap-2 pt-2">
                            <button type="button" onclick="document.getElementById('addAnnouncementBox').classList.add('hidden')" class="px-4 py-2 border border-slate-800 hover:bg-slate-800 rounded-lg text-slate-300 font-bold">Cancel</button>
                            <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-lg shadow-md shadow-blue-900/10">Publish Bulletin</button>
                        </div>
                    </form>
                </div>

                <!-- Announcements list -->
                <% if (announcements && announcements.length > 0) { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <% announcements.forEach(function(item) { %>
                            <div class="p-5 bg-navy-900 border border-slate-800 rounded-xl flex gap-4 items-start justify-between">
                                <div class="flex gap-4">
                                    <div class="w-12 h-12 bg-rose-500/10 border border-rose-500/20 rounded-lg flex items-center justify-center text-rose-400 text-lg flex-shrink-0"><i class="bi bi-megaphone"></i></div>
