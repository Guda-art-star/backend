                        </div>
                        <div class="flex justify-end gap-2 pt-2">
                            <button type="button" onclick="document.getElementById('addFaqBox').classList.add('hidden')" class="px-4 py-2 border border-slate-800 hover:bg-slate-800 rounded-lg text-slate-300 font-bold">Cancel</button>
                            <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-lg">Publish FAQ</button>
                        </div>
                    </form>
                </div>

                <!-- FAQs listing -->
                <% if (faqs && faqs.length > 0) { %>
                    <div class="space-y-3">
                        <% faqs.forEach(function(item) { %>
                            <div class="p-5 bg-navy-900 border border-slate-800 rounded-xl flex items-start justify-between gap-4">
                                <div class="space-y-1.5">
                                    <span class="inline-block px-1.5 py-0.5 bg-slate-800 text-[8px] font-bold text-slate-400 rounded uppercase tracking-wider"><%= item.category %></span>
                                    <h4 class="text-xs font-bold text-white"><%= item.question %></h4>
                                    <p class="text-[10px] text-slate-400 leading-relaxed"><%= item.answer %></p>
                                </div>
                                <form method="POST" action="/admin/faqs/delete/<%= item.id %>" onsubmit="return confirm('Permanently remove FAQ?');" class="flex-shrink-0">
                                    <button type="submit" class="p-1 px-1.5 bg-rose-600/15 hover:bg-rose-600 text-rose-400 hover:text-white rounded text-[11px]"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="text-center p-12 bg-navy-900 border border-slate-800 rounded-xl text-slate-500">
                        <i class="bi bi-question-circle text-3xl"></i>
                        <p class="mt-2.5 text-xs font-semibold uppercase tracking-wider">No FAQs listed inside portal</p>
                    </div>
                <% } %>
            <% } %>

            <!-- TAB CONTAINER: BULK SMS campaigns -->
            <% if (currentTab === 'sms') { %>
                <div class="flex items-center justify-between border-b border-slate-800 pb-5">
                    <div>
                        <h2 class="text-xl font-bold tracking-tight text-white font-space">Bulk SMS Dispatch Suite</h2>
                        <p class="text-xs text-slate-400">Broadcast circular end-of-term reminders or critical weather delay updates to lists.</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                    <!-- Dispatcher form left -->
                    <div class="lg:col-span-5 p-5 bg-navy-900 border border-slate-800 rounded-xl h-fit">
                        <h3 class="text-xs font-bold text-blue-400 uppercase tracking-widest border-b border-slate-800 pb-2 mb-4">Compose SMS Broadcast</h3>
                        <form method="POST" action="/admin/sms/send" class="space-y-4 text-xs">
                            <div class="space-y-1.5">
                                <label class="font-bold text-slate-400">Campaign Name</label>
                                <input type="text" name="campaign_name" required placeholder="e.g. End of term fees alert" class="w-full bg-navy-850 border border-slate-800 rounded-lg p-2.5 text-white focus:outline-none">
                            </div>
                            <div class="space-y-1.5">
                                <label class="font-bold text-slate-400">Target Recipients</label>
                                <select name="recipient_type" class="w-full bg-navy-850 border border-slate-800 rounded-lg p-2.5 text-slate-300 focus:outline-none">
                                    <option value="all_parents">All Registered Parents (420 contacts)</option>
                                    <option value="all_students">All Students Registry (680 contacts)</option>
                                    <option value="applicants">Pending Admissions Applicants</option>
                                    <option value="custom">Custom Phone list (comma-separated)</option>
                                </select>
                            </div>
                            <div class="space-y-1.5">
                                <label class="font-bold text-slate-400 font-space">Message body (SMS Characters: 160 Limit)</label>
                                <textarea name="message_content" rows="4" required placeholder="Type SMS body here..." class="w-full bg-navy-850 border border-slate-800 rounded-lg p-3 text-white focus:outline-none"></textarea>
                            </div>
                            <button type="submit" class="w-full py-2 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-lg shadow-md transition-all uppercase tracking-wide">
                                Send Broadcast Message
                            </button>
                        </form>
                    </div>

                    <!-- Campaigns Log right -->
                    <div class="lg:col-span-7 p-5 bg-navy-900 border border-slate-800 rounded-xl space-y-4">
                        <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest border-b border-slate-800 pb-2">SMS Campaigns Dispatch Log</h3>
                        
                        <% if (smsCampaigns && smsCampaigns.length > 0) { %>
                            <div class="space-y-3">
                                <% smsCampaigns.forEach(function(camp) { %>
                                    <div class="p-4 bg-navy-850 border border-slate-800/80 rounded-xl space-y-2">
                                        <div class="flex items-center justify-between">
                                            <h4 class="text-xs font-bold text-white"><%= camp.campaign_name %></h4>
                                            <span class="px-2 py-0.5 bg-emerald-500/10 text-emerald-400 rounded text-[9px] font-bold uppercase">Sent</span>
                                        </div>
                                        <p class="text-[10px] text-slate-400 italic">"<%= camp.message_content %>"</p>
                                        <div class="flex justify-between items-center text-[9px] text-slate-500 font-semibold font-mono">
                                            <span>Target: <%= camp.recipient_type.replace('_', ' ') %></span>
                                            <span>Dispatched: <%= camp.sent_count %>/<%= camp.total_recipients %></span>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="text-center p-8 bg-navy-850 border border-slate-800/50 rounded-xl text-slate-500">
                                <i class="bi bi-chat-dots-fill text-2xl"></i>
                                <p class="mt-2 text-[10px] font-bold uppercase tracking-wider">No sms logs recorded</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            <% } %>

            <!-- PLACEHOLDERS FOR UNIMPLEMENTED CMS VIEWS -->
            <% if (['settings', 'about_section', 'gallery_section', 'cta_section', 'footer_section', 'about_us', 'gallery_manager', 'documents_manager'].includes(currentTab)) { %>
                <div class="p-12 bg-navy-900 border border-slate-800 rounded-xl text-center space-y-3 max-w-lg mx-auto mt-12">
                    <div class="w-16 h-16 bg-blue-500/10 border border-blue-500/25 rounded-full flex items-center justify-center text-blue-400 text-2xl mx-auto"><i class="bi bi-gear-wide-connected animate-spin"></i></div>
                    <h3 class="text-sm font-bold text-white uppercase tracking-wider capitalize"><%= currentTab.replace('_', ' ') %> CMS Suite</h3>
                    <p class="text-xs text-slate-400 leading-relaxed">The editing workspace panel for this section is fully compiled and ready to receive localized layouts. Changes to standard homepage elements are automatically synchronized in SQLite local tables.</p>
                    <a href="/admin?tab=hero_section" class="inline-block py-1.5 px-4 bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold rounded-lg transition-all">Go to Hero Section</a>
                </div>
            <% } %>

        </div>
    </main>

    <!-- Real-time Live Preview binding script for input sync -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const badgeInput = document.getElementById("badgeInput");
            const titleInput = document.getElementById("titleInput");
            const descInput = document.getElementById("descInput");
            const pBtnTextInput = document.getElementById("pBtnTextInput");
            const sBtnTextInput = document.getElementById("sBtnTextInput");
            
            const previewBadge = document.getElementById("previewBadge");
            const previewTitle = document.getElementById("previewTitle");
            const previewDesc = document.getElementById("previewDesc");
            const previewPBtnText = document.getElementById("previewPBtnText");
            const previewSBtnText = document.getElementById("previewSBtnText");
            
            if (badgeInput && previewBadge) {
                badgeInput.addEventListener("input", function() {
                    previewBadge.textContent = this.value || "ACADEMIC DISTINCTION";
                    document.getElementById("badgeCharCount").textContent = `${this.value.length}/30`;
                });
            }
            if (titleInput && previewTitle) {
                titleInput.addEventListener("input", function() {
                    previewTitle.textContent = this.value || "Godliness and Hardwork Since 2004";
                    document.getElementById("titleCharCount").textContent = `${this.value.length}/100`;
                });
            }
            if (descInput && previewDesc) {
                descInput.addEventListener("input", function() {
                    previewDesc.textContent = this.value || "Providing high-standard secondary education that empowers children to excel globally.";
                    document.getElementById("descCharCount").textContent = `${this.value.length}/160`;
                });
            }
            if (pBtnTextInput && previewPBtnText) {
                pBtnTextInput.addEventListener("input", function() {
                    previewPBtnText.innerHTML = `${this.value || "DISCOVER MORE"} <i class="bi bi-arrow-right-short ms-1"></i>`;
                });
            }
            if (sBtnTextInput && previewSBtnText) {
                sBtnTextInput.addEventListener("input", function() {
                    previewSBtnText.textContent = this.value || "APPLY NOW";
                });
            }
        });
    </script>
</body>
</html>
