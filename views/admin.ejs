                        </div>
                        <div class="space-y-1.5">
                            <label class="font-semibold text-slate-400">Entrance Fee State</label>
                            <input type="text" name="cost" required placeholder="e.g. Free Entry" class="w-full bg-navy-850 border border-slate-800 rounded-lg p-2.5 text-white focus:outline-none focus:border-blue-500/50">
                        </div>
                        <div class="md:col-span-2 space-y-1.5">
                            <label class="font-semibold text-slate-400">Short description</label>
                            <textarea name="description" rows="3" required placeholder="Detail the event's instructions here..." class="w-full bg-navy-850 border border-slate-800 rounded-lg p-3 text-white focus:outline-none focus:border-blue-500/50"></textarea>
                        </div>
                        <div class="md:col-span-2 flex justify-end gap-2 pt-2">
                            <button type="button" onclick="document.getElementById('addEventBox').classList.add('hidden')" class="px-4 py-2 border border-slate-800 hover:bg-slate-800 rounded-lg text-slate-300 font-bold">Cancel</button>
                            <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-lg">Schedule Event</button>
                        </div>
                    </form>
                </div>

                <!-- Events layout -->
                <% if (events && events.length > 0) { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <% events.forEach(function(event) { %>
