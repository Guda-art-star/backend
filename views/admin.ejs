                                            </td>
                                            <td class="p-4 font-bold text-slate-300 font-mono"><%= alumn.graduation_year %></td>
                                            <td class="p-4 text-slate-300 font-medium"><%= alumn.current_profession %></td>
                                            <td class="p-4 text-slate-400 max-w-xs truncate" title="<%= alumn.quote %>">"<%= alumn.quote %>"</td>
                                            <td class="p-4">
