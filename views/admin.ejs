                                        <span class="inline-block px-1.5 py-0.5 bg-slate-800 text-[8px] font-bold text-slate-400 rounded uppercase tracking-wider"><%= member.category %></span>
                                        <h4 class="text-xs font-bold text-white"><%= member.name %></h4>
